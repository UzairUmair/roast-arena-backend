{
  "name": "startup-roast-arena-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Startup Roast Arena, a student MERN assignment.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest",
    "lint": "node --check src/app.js && node --check src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "groq-sdk": "^0.36.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
